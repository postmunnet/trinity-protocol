{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://browser-cli/schema/config.schema.json",
  "title": "Browser CLI Config",
  "type": "object",
  "required": ["baseUrl"],
  "additionalProperties": true,
  "properties": {
    "baseUrl": { "type": "string" },
    "timeout": { "type": "number", "minimum": 0 },
    "downloadDir": { "type": "string" },
    "helpers": { "type": "string", "description": "Path to YAML helper file" },
    "policy": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["safe", "normal", "aggressive"] },
        "allowHigh": { "type": "boolean" }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["loginUrl", "fields"],
        "properties": {
          "loginUrl": { "type": "string" },
          "csrfField": { "type": "string" },
          "submitField": { "type": "string" },
          "fields": {
            "type": "object",
            "additionalProperties": { "type": ["string", "number"] }
          }
        }
      }
    }
  }
}
