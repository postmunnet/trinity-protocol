#!/usr/bin/env bash
set -euo pipefail

# Trinity CLI Entrypoint
# Runs main.py as a module to enable relative imports

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
AI_ROOT="$(dirname "$SCRIPT_DIR")"

# Change to .ai root so module imports work correctly
cd "$AI_ROOT"

# Run as module (fixes ImportError from relative imports)
python3 -m cli.main "$@"
