{
  "check_template_version": "1.0",
  "required_artifacts": [
    "{{session.dir}}/DO/dev/",
    "{{session.dir}}/.state/gogogo/",
    "{{session.dir}}/.state/plan.json",
    "{{session.dir}}/.state/gogogo/step_{{step.id}}/verifier_report.json",
    "{{session.dir}}/.state/gogogo/step_{{step.id}}/step_log.md"
  ],
  "required_headings": [
    "# Step",
    "## Verdict",
    "## Evidence"
  ],
  "required_fields": {
    "{{session.dir}}/.state/gogogo/step_{{step.id}}/verifier_report.json": "verdict+evidence_ref+step_id",
    "{{session.dir}}/.state/plan.json": "steps"
  },
  "required_evidence_refs": {
    "gogogo.invoked_audit_event": {
      "kind": "audit_event",
      "event_type": "gogogo.invoked",
      "required": true,
      "description": "gogogo.invoked MUST be appended to .ai/audit/events.ndjson before any step body runs."
    },
    "gogogo.step_started_audit_event": {
      "kind": "audit_event",
      "event_type": "gogogo.step_started",
      "required": true,
      "description": "Each step body MUST be preceded by gogogo.step_started recording step.id and step.owner_role."
    },
    "gogogo.step_verdict_audit_event": {
      "kind": "audit_event",
      "event_type": "gogogo.step_passed_or_failed",
      "required": true,
      "description": "Each step MUST emit either gogogo.step_passed or gogogo.step_failed referencing the verifier_report.json path and sha256."
    },
    "verifier_report.evidence_ref": {
      "kind": "artifact_ref",
      "required": true,
      "description": "Per-step verifier_report.json MUST carry an evidence_ref (artifact path + sha256, or audit event id) per Constitution Article VIII."
    }
  },
  "required_structural_predicates": [
    {"predicate": "verifier_report.verdict in [PASS, FAIL, UNVERIFIED]", "required": true},
    {"predicate": "verifier_report.evidence_ref is_present", "required": true},
    {"predicate": "verifier_report.step_id matches plan.steps[].id", "required": true},
    {"predicate": "step.owner_role != decided_by", "required": true},
    {"predicate": "plan.json.exists == true", "required": true},
    {"predicate": "audit.chain.appended_only == true", "required": true},
    {"predicate": "writes.outside.DO_dev == false", "required": true},
    {"predicate": "writes.to.DO_prod == false", "required": true},
    {"predicate": "retry.attempts <= 3", "required": true},
    {"predicate": "retry.preserve_failed_attempts == true", "required": true},
    {"predicate": "session.current_state in [PLAN, SANDBOX, EXECUTE]_at_invocation", "required": true},
    {"predicate": "session.next_state in [SANDBOX, EXECUTE, VERIFY]_after_success", "required": true}
  ],
  "required_phrases": [],
  "forbidden_phrases": [
    "{{user_input}}",
    "verdict: PASS_NO_EVIDENCE",
    "auto-certified",
    "self-certified",
    "approved",
    "deployed",
    "promoted",
    "canonical truth",
    "auto-pinned",
    "memory learned"
  ],
  "forbidden_actions": [
    "write_to_do_prod",
    "modify_audit_chain",
    "modify_canonical_policies",
    "modify_schemas",
    "self_certify_step_pass",
    "skip_verifier_evidence",
    "decide_workflow_meaning",
    "auto_promote",
    "auto_deploy",
    "semantic_synthesis",
    "self_trigger",
    "memory_learn",
    "auto_pin",
    "modify_plan_json_outside_amendment",
    "write_to_other_session_directory",
    "skip_audit_emission"
  ],
  "allowed_roles": [
    "Executor Agent",
    "Verifier Agent",
    "Kernel"
  ],
  "forbidden_roles": [
    "Transport",
    "Memory CLI",
    "Retro Writer",
    "Planning Agent",
    "Clarification Agent",
    "Presentation Synthesizer",
    "Session Initializer"
  ],
  "state_transition": {
    "from": ["PLAN", "SANDBOX", "EXECUTE"],
    "to": ["SANDBOX", "EXECUTE", "VERIFY"]
  },
  "failure_behavior": {
    "on_missing_artifact": "BLOCK",
    "on_missing_evidence": "BLOCK",
    "on_forbidden_phrase": "BLOCK",
    "on_optional_failure": "WARN"
  }
}
