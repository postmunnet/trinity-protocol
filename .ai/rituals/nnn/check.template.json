{
  "check_template_version": "1.0",
  "required_artifacts": [
    "THINK/plan_envelope.json",
    "THINK/02_SCOPE.md",
    "THINK/03_ACCEPTANCE.md",
    "THINK/verification_contract.json",
    "THINK/risk_assessment.json",
    "THINK/rollback.md",
    ".state/nnn_pass"
  ],
  "required_headings": [
    "# Scope",
    "## In Scope",
    "## Out of Scope",
    "## Constraints",
    "## Acceptance",
    "## Rollback"
  ],
  "required_fields": {
    "THINK/plan_envelope.json": "goal,tier,allowed_paths,forbidden_paths,acceptance,rollback,steps",
    "THINK/verification_contract.json": "predicates,verifier_rules_ref,acceptance_refs",
    "THINK/risk_assessment.json": "risks,mitigations,tier"
  },
  "required_evidence_refs": {
    "vvv_pass": {
      "kind": "state_sentinel",
      "path": ".state/vvv_pass",
      "required": true,
      "description": "Article XII: nnn MUST follow vvv. The kernel-written vvv_pass sentinel proves clarification completed."
    },
    "session_meta": {
      "kind": "session_manifest",
      "path": "CONTROL/META.json",
      "required": true,
      "description": "Session capsule manifest written by sss; used to anchor session.slug and operator.name."
    }
  },
  "required_structural_predicates": [
    {"predicate": "plan_envelope.tier in [HOT,WARM,COLD]", "required": true},
    {"predicate": "plan_envelope.goal.length >= 8", "required": true},
    {"predicate": "plan_envelope.allowed_paths.length >= 1", "required": true},
    {"predicate": "plan_envelope.forbidden_paths.length >= 1", "required": true},
    {"predicate": "plan_envelope.acceptance.length >= 1", "required": true},
    {"predicate": "plan_envelope.rollback.length >= 1", "required": true},
    {"predicate": "plan_envelope.steps.length >= 1", "required": true},
    {"predicate": "verification_contract.predicates.length >= 1", "required": true},
    {"predicate": "risk_assessment.risks.length >= 0", "required": false}
  ],
  "required_phrases": [],
  "forbidden_phrases": [
    "{{user_input}}",
    "TODO: fill in",
    "PLACEHOLDER",
    "self-certified PASS"
  ],
  "forbidden_actions": [
    "execute_code",
    "mutate_DO_dev",
    "mutate_DO_prod",
    "modify_audit_chain",
    "modify_canonical_policies",
    "decide_verifier_verdict",
    "self_certify_plan_pass",
    "semantic_synthesis",
    "auto_promote",
    "skip_rollback_declaration",
    "skip_acceptance_declaration"
  ],
  "allowed_roles": [
    "Planning Agent",
    "Kernel"
  ],
  "forbidden_roles": [
    "Transport",
    "Memory CLI",
    "Retro Writer",
    "Executor Agent",
    "Verifier Agent",
    "Presentation Synthesizer",
    "Session Initializer",
    "Clarification Agent"
  ],
  "state_transition": {
    "from": ["THINK"],
    "to": ["PLAN"]
  },
  "failure_behavior": {
    "on_missing_artifact": "BLOCK",
    "on_missing_evidence": "BLOCK",
    "on_forbidden_phrase": "BLOCK",
    "on_optional_failure": "WARN"
  }
}
