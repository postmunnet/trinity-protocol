{
  "check_template_version": "1.0",
  "required_artifacts": [
    ".state/ddd/decision_packet.json",
    ".state/ddd/approval.json",
    ".state/ddd/rejection.json",
    ".state/ddd/hold.json"
  ],
  "required_headings": [
    "# Decision Packet",
    "## Goal",
    "## Verifier Report",
    "## Risk",
    "## Requested Action"
  ],
  "required_fields": {
    "decision_packet.json": "session_id+requested_action+tier+verifier_report_ref+audit_chain_anchor"
  },
  "required_evidence_refs": {
    "verifier_report_ref": {
      "kind": "artifact_ref",
      "required": true,
      "description": "Reference to verifier_report.json that justifies the requested action. Article XV — decisions must cite evidence."
    },
    "audit_chain_anchor": {
      "kind": "audit_hash",
      "required": true,
      "description": "Head hash of audit chain at packet-proposal time; kernel verifies no chain drift before applying decision."
    },
    "operator_signed_envelope": {
      "kind": "hmac_envelope",
      "required": true,
      "description": "HMAC-signed envelope from operator carrying approval/rejection/hold. Failure to verify emits ddd.hmac_rejected (exit 79). Transport delivers; kernel verifies."
    }
  },
  "required_structural_predicates": [
    {"predicate": "decision.decided_by == human", "required": true},
    {"predicate": "exactly_one(approval.json,rejection.json,hold.json) is_present", "required": true},
    {"predicate": "decision_packet.verifier_report_ref is_present", "required": true},
    {"predicate": "transport.role != decision.decider", "required": true},
    {"predicate": "decision_packet.tier in (HOT,WARM,COLD)", "required": true},
    {"predicate": "decision_packet.requested_action in (PROMOTE,DEPLOY,ABORT,ROLLBACK)", "required": true},
    {"predicate": "decision_packet.audit_chain_anchor is_present", "required": true},
    {"predicate": "presentation.dissent_summary is_present_or_explicitly_empty", "required": false}
  ],
  "required_phrases": [],
  "forbidden_phrases": [
    "{{user_input}}",
    "decided_by: ai",
    "decided_by: kernel",
    "auto-approved"
  ],
  "forbidden_actions": [
    "ai_self_decide",
    "transport_side_approval",
    "modify_audit_chain",
    "modify_policies",
    "auto_approve_on_timeout",
    "synthesize_decision_without_human",
    "bypass_hmac_verification",
    "drop_dissent_from_packet"
  ],
  "allowed_roles": [
    "Human Operator",
    "Verifier Agent",
    "Presentation Synthesizer",
    "Kernel"
  ],
  "forbidden_roles": [
    "Transport",
    "Memory CLI",
    "Retro Writer",
    "Executor Agent",
    "Planning Agent"
  ],
  "state_transition": {
    "from": ["VERIFY", "NEEDS_HUMAN"],
    "to": ["PROMOTE", "NEEDS_HUMAN", "FAILED"]
  },
  "failure_behavior": {
    "on_missing_artifact": "BLOCK",
    "on_missing_evidence": "BLOCK",
    "on_forbidden_phrase": "BLOCK",
    "on_optional_failure": "WARN"
  }
}
